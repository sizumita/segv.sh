{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "segv-sh",
  // Built by `qwik build` (vite SSR build of src/entry.cloudflare-workers.ts). Wrangler re-bundles it.
  "main": "./server/entry.cloudflare-workers.js",
  // Must stay <= the bundled workerd release (2026-10-23).
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  // Serve ONLY on the canonical custom domain: the passkey RP ID is the page hostname, so a registration
  // on <name>.<account>.workers.dev or on a version preview URL would mint passkeys bound to that host
  // (useless once it goes away) while writing to the production log, and preview URLs would run
  // undeployed code against production data. Attach segv.sh as a Custom Domain of this Worker.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    // MUST be "ASSETS": Qwik's cloudflare-pages middleware calls env.ASSETS.fetch() for static paths.
    "binding": "ASSETS",
    "directory": "./dist",
    // API + websocket paths always hit the Worker (never the asset server).
    "run_worker_first": ["/api/*"],
  },
  // The directory (accounts, key wraps, the dirlog hash chain; docs/PROTOCOL.md §9.6). See migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "segv",
      "database_id": "6a771a84-e88a-4daa-a66d-1a3c0bed025d",
      "migrations_dir": "migrations",
    },
  ],
  // Client-side-encrypted, content-addressed blobs: key "b/<b64u(sha256(blob))>".
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "segv-blobs" }],
  // docs/PROTOCOL.md §9: SHARD "shard/v2/{E}/{i}" and INBOX "inbox/v2/{E}/{g}" per era, BLOBREG
  // "blobreg/v2", RT "rt/v2/0" (realtime WebSockets), CKPT "ckpt/v2" (signed checkpoints every 60 s),
  // PUSH "push/v2" (Web Push registrations; addressed only while push is on, §9.8).
  "durable_objects": {
    "bindings": [
      { "name": "SHARD", "class_name": "ShardDO" },
      { "name": "BLOBREG", "class_name": "BlobRegDO" },
      { "name": "INBOX", "class_name": "InboxDO" },
      { "name": "RT", "class_name": "RealtimeDO" },
      { "name": "CKPT", "class_name": "CheckpointDO" },
      { "name": "PUSH", "class_name": "PushDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ShardDO", "BlobRegDO", "InboxDO", "RealtimeDO", "CheckpointDO"],
    },
    // Web Push (§9.8).
    { "tag": "v2", "new_sqlite_classes": ["PushDO"] },
  ],
  // Per-IP (IPv6 /64) abuse limits. Keys are never persisted. Period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "RL_WRITE", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_BLOB", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } },
    // Inbox posts (one token per POST of up to 32 invites).
    { "name": "RL_INBOX", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    // Rings after each text or image (§10.10): their own binding, so that ringing leaves RL_WRITE to the puts.
    { "name": "RL_RING", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } },
  ],
  "vars": {
    // Proof-of-work base difficulty (leading zero bits) per scope, docs/PROTOCOL.md §10.2. Puts, inbox
    // posts and blobs need more for larger bodies (proto.powDifficulty).
    "POW_REGISTER": "20",
    "POW_WRAP": "18",
    "POW_PUT": "16",
    "POW_INBOX": "18",
    "POW_BLOB": "18",
    // Deployment parameters (docs/PROTOCOL.md §3.1, §9.3, §9.7). Treat them as constants of the
    // deployment (the Durable Objects pin Δ and Δin at their first write).
    // DELTA_S = Δ (row time granularity; must divide 604800, else the API answers 503), SKEW_S = bound on
    // clock differences between server components, INBOX_SLOT_S = Δin, E_FIRST = the era of the first deploy
    // (lower eras are never instantiated).
    // Secrets (wrangler secret put; .dev.vars for vp dev): ROUTE_KEY (32 B b64u), SRV_KEY (Ed25519 seed b64u).
    // Web Push is off unless the secrets VAPID_SK (P-256 scalar, 32 B b64u) and PUSH_KEY (32 B b64u) are set, with
    // VAPID_SUB (mailto: or https: contact). Optional: PUSH_HOSTS, POW_PUSH (20), PUSH_MAX_SUBS (100000),
    // PUSH_DAY_SUBS (2000). An invalid push setting turns push off and nothing else (docs/PROTOCOL.md §9.8).
    "DELTA_S": "10",
    "SKEW_S": "2",
    "INBOX_SLOT_S": "10",
    "E_FIRST": "42",
    // Hostnames this Worker answers on (comma-separated; the first is canonical). Any other host gets a
    // 308 to https://<first><path> (pages) or 421 (/api/*). "" disables the check. localhost = local dev
    // (vp dev, wrangler dev, test/e2e). src/server/hosts.ts.
    "APP_HOSTS": "segv.sh,localhost",
  },
  // Workers Logs: keep only our own console.error lines (they never contain addresses, ids or bodies).
  // Invocation logs would retain every request's URL (handles, credential / blob ids) and request
  // metadata for days, which the design promises not to keep.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "routes": [{ "pattern": "segv.sh", "custom_domain": true }],
}
