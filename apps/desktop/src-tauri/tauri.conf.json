{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "segv.sh",
  "version": "0.1.0",
  "identifier": "sh.segv.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev.web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build.web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "segv.sh",
        "width": 1100,
        "height": 760,
        "minWidth": 560,
        "minHeight": 420,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 24 },
        "transparent": true,
        "windowEffects": {
          "effects": ["liquidGlassRegular", "sidebar"],
          "state": "followsWindowActiveState"
        },
        "backgroundThrottling": "disabled",
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' blob: data:",
        "font-src": "'self'",
        "connect-src": "'self' https://segv.sh wss://segv.sh ipc: http://ipc.localhost blob:",
        "worker-src": "'self'",
        "media-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'",
        "require-trusted-types-for": "'script'",
        "trusted-types": "segv-worker"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self'",
        "connect-src": "'self' ws://localhost:1420 ipc: http://ipc.localhost blob:",
        "worker-src": "'self'",
        "media-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "SocialNetworking",
    "shortDescription": "end-to-end encrypted messenger",
    "copyright": "segv.sh contributors, AGPL-3.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["segv"] }
    }
  }
}
