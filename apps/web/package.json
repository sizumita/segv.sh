{
  "name": "@segv/web",
  "private": true,
  "description": "https://segv.sh: one Cloudflare Worker that serves the Qwik UI (server-side rendered), the API and the Durable Objects.",
  "type": "module",
  "scripts": {
    "dev": "vp dev --mode ssr",
    "build": "qwik build",
    "build.client": "vp build",
    "build.server": "qwik check-client src dist && vp build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "preview": "qwik build && wrangler dev",
    "deploy": "qwik build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "qwik": "qwik",
    "test:e2e": "node test/e2e/run.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qwik.dev/core": "catalog:",
    "@qwik.dev/router": "catalog:",
    "@segv/engine": "workspace:*",
    "@segv/server": "workspace:*",
    "@segv/ui": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@segv/protocol": "workspace:*",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
