{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "segv-sh",
  // Built by `qwik build` (vite SSR build of src/entry.cloudflare-workers.ts). Wrangler re-bundles it.
  "main": "./server/entry.cloudflare-workers.js",
  // Must stay <= the bundled workerd release (2026-10-23).
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  // Serve ONLY on the canonical custom domain: the passkey RP ID is the page hostname, so a registration
  // on <name>.<account>.workers.dev or on a version preview URL would mint passkeys bound to that host
  // (useless once it goes away) while writing to the production log, and preview URLs would run
  // undeployed code against production data. Attach segv.sh as a Custom Domain of this Worker.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    // MUST be "ASSETS": Qwik's cloudflare-pages middleware calls env.ASSETS.fetch() for static paths.
    "binding": "ASSETS",
    "directory": "./dist",
    // API + websocket paths always hit the Worker (never the asset server).
    "run_worker_first": ["/api/*"],
  },
  // The directory (docs/PROTOCOL.md §9.6): DIRLOG is its log database (the dirlog hash chain and the user count) and
  // DB, DB1 … DB{K−1} its K = DIR_SHARDS user databases (accounts, key wraps). A deployment starts with one database
  // for both, so DIRLOG and DB name the same database here. To raise DIR_SHARDS: create the new databases, apply the
  // migrations to each, bind them as DB1 …, set DIR_SHARDS and deploy (docs/DEPLOYMENT.md); the DirSeqDO then moves
  // the rows. The schema belongs to the API (packages/server/migrations).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "segv",
      "database_id": "6a771a84-e88a-4daa-a66d-1a3c0bed025d",
      "migrations_dir": "../../packages/server/migrations",
    },
    {
      "binding": "DIRLOG",
      "database_name": "segv",
      "database_id": "6a771a84-e88a-4daa-a66d-1a3c0bed025d",
      "migrations_dir": "../../packages/server/migrations",
    },
  ],
  // Client-side-encrypted, content-addressed blobs: key "b/<b64u(sha256(blob))>". Also the rows, index and manifest of
  // every sealed era's shards ("seal/v2/{E}/{i}/…", docs/PROTOCOL.md §9.1 "Paging"), which the shards write
  // themselves before they empty their storage.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "segv-blobs" }],
  // The push store (docs/PROTOCOL.md §9.8): sealed registrations, written at once; a KV namespace keeps no history.
  // Create it with `wrangler kv namespace create segv-push` and put its id here (docs/DEPLOYMENT.md).
  "kv_namespaces": [{ "binding": "PUSH_KV", "id": "b230903c4bec4e4e9e2641c61e253aa6" }],
  // Pushes due later than a Worker can wait (§9.8 "The Worker's part"): a message names the QuietDO to ask, nothing else.
  "queues": {
    "producers": [{ "binding": "PUSH_QUEUE", "queue": "segv-push" }],
    "consumers": [
      { "queue": "segv-push", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 3 },
    ],
  },
  // The daily expiry of push registrations not refreshed for 30 days (§9.8 "Expiry").
  "triggers": { "crons": ["17 3 * * *"] },
  // docs/PROTOCOL.md §9: SHARD "shard/v2/{E}/{i}" and INBOX "inbox/v2/{E}/{g}" per era, BLOBREG
  // "blobreg/v2/{j}" (BLOBREG_SHARDS of them; "blobreg/v2" is the first release's registry, which they import from,
  // §9.2), DIRSEQ "dirseq/v2" (the only writer of the directory, §9.6), KEYS "keys/v2" (the per-era inbox bucket
  // keys, §9.3), CONN "conn/v2/{c}" (the realtime WebSockets,
  // RT_CONNS of them) and FEED "feed/v2/{j}" (topic fan-out to the ConnDOs, RT_FEEDS of them; §9.4), CKPT "ckpt/v2"
  // (signed checkpoints every 60 s) and QUIET "quiet/v2/{k}" (push: each account's registrations, window, hold and
  // seen marks, memory only, PUSH_SHARDS of them; addressed only while push is on, §9.8).
  "durable_objects": {
    "bindings": [
      { "name": "SHARD", "class_name": "ShardDO" },
      { "name": "BLOBREG", "class_name": "BlobRegDO" },
      { "name": "DIRSEQ", "class_name": "DirSeqDO" },
      { "name": "KEYS", "class_name": "KeyDO" },
      { "name": "INBOX", "class_name": "InboxDO" },
      { "name": "CONN", "class_name": "ConnDO" },
      { "name": "FEED", "class_name": "FeedDO" },
      { "name": "CKPT", "class_name": "CheckpointDO" },
      { "name": "QUIET", "class_name": "QuietDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ShardDO", "BlobRegDO", "InboxDO", "RealtimeDO", "CheckpointDO"],
    },
    // Web Push (§9.8).
    { "tag": "v2", "new_sqlite_classes": ["PushDO"] },
    // The realtime path split into ConnDOs and FeedDOs (§9.4), and push moved to the KV store with memory-only QuietDOs
    // (§9.8). The RealtimeDO (a tag key) and the PushDO (registrations, which devices make again at their next start or
    // within a day) are gone.
    {
      "tag": "v3",
      "new_sqlite_classes": ["ConnDO", "FeedDO", "QuietDO"],
      "deleted_classes": ["RealtimeDO", "PushDO"],
    },
    // The directory's single writer (§9.6). The blob registry's shards are more objects of the existing BlobRegDO.
    { "tag": "v4", "new_sqlite_classes": ["DirSeqDO"] },
    // The per-era inbox bucket keys (§9.3 "Buckets").
    { "tag": "v5", "new_sqlite_classes": ["KeyDO"] },
  ],
  // Per-IP (IPv6 /64) abuse limits. Keys are never persisted. Period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "RL_WRITE", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_BLOB", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } },
    // Inbox posts (one token per POST of up to 32 invites).
    { "name": "RL_INBOX", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    // Rings after each text or image (§10.10): their own binding, so that ringing leaves RL_WRITE to the puts.
    { "name": "RL_RING", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } },
    // Marks of rows a device in use has shown (§10.10): their own binding, so that they never take the rings' tokens.
    { "name": "RL_SEEN", "namespace_id": "1006", "simple": { "limit": 60, "period": 60 } },
  ],
  "vars": {
    // Proof-of-work base difficulty (leading zero bits) per scope, docs/PROTOCOL.md §10.2. Puts, inbox
    // posts and blobs need more for larger bodies (proto.powDifficulty).
    "POW_REGISTER": "20",
    "POW_WRAP": "18",
    "POW_PUT": "16",
    "POW_INBOX": "18",
    "POW_BLOB": "18",
    // Deployment parameters (docs/PROTOCOL.md §3.1, §9.3, §9.7). Treat them as constants of the
    // deployment (the Durable Objects pin Δ and Δin at their first write).
    // DELTA_S = Δ (row time granularity; must divide 604800, else the API answers 503), SKEW_S = bound on
    // clock differences between server components, INBOX_SLOT_S = Δin, E_FIRST = the era of the first deploy
    // (lower eras are never instantiated). SHARD_MAP (optional, §9.1) = the shard count per era as "E:S" entries
    // (S a power of two), in effect from era E on; unset = one shard per era. Add an entry only for an era that
    // has not started; never change the count of an era that accepts writes. BLOBREG_SHARDS (§9.2) = the number
    // of blob registry objects, a power of two: a constant of the deployment, never changed once a blob is
    // registered (ids would route to another object). INBOX_MAP (optional, §9.3) = the inbox bucket count per era,
    // "E:B" entries like SHARD_MAP (B a power of two; unset = one bucket): raise it for an era that has not started
    // (see below). DIR_SHARDS (§9.6) = the directory's user databases DB, DB1 …, a power of two; unset = one. Only
    // ever raise it, and only in a deploy after the one that introduced the DirSeqDO: it then moves the rows.
    // once the user count passes 2 · 16 384 · B, never for one that accepts posts.
    // Secrets (wrangler secret put; .dev.vars for vp dev): ROUTE_KEY (32 B b64u), SRV_KEY (Ed25519 seed b64u).
    // Web Push is off unless the secrets VAPID_SK (P-256 scalar, 32 B b64u) and PUSH_KEY (32 B b64u) are set, with
    // VAPID_SUB (mailto: or https: contact). Optional: PUSH_HOSTS, POW_PUSH (20), PUSH_SHARDS (1). An invalid push
    // setting turns push off and nothing else (docs/PROTOCOL.md §9.8).
    "DELTA_S": "10",
    "SKEW_S": "2",
    "INBOX_SLOT_S": "10",
    "E_FIRST": "42",
    // The realtime path (docs/PROTOCOL.md §9.4): C ConnDOs hold the sockets (a client's go to one of them) and F
    // FeedDOs (a power of two) fan rows out to them. Both may change at any deploy; sockets live at most an hour.
    "RT_CONNS": "4",
    "RT_FEEDS": "4",
    "BLOBREG_SHARDS": "64",
    // Push: the number of QuietDOs (§9.8). May change at any deploy; the store is the truth.
    "PUSH_SHARDS": "4",
    // Hostnames this Worker answers on (comma-separated; the first is canonical). Any other host gets a
    // 308 to https://<first><path> (pages) or 421 (/api/*). "" disables the check. localhost = local dev
    // (vp dev, wrangler dev, test/e2e). packages/server/src/hosts.ts.
    "APP_HOSTS": "segv.sh,localhost",
    // Origins of the native apps (docs/PROTOCOL.md §9.7, §11.14; comma-separated https:, capacitor: or tauri:
    // origins without a path or port): their pages may read API answers (CORS) and open the realtime socket. Unset
    // or invalid = none (an invalid value is logged by name). iOS, Android, macOS/Linux, Windows.
    // packages/server/src/origins.ts.
    "APP_ORIGINS": "capacitor://app.segv.sh,https://app.segv.sh,tauri://localhost,https://tauri.localhost",
    // App IDs (<Team ID>.<bundle id>, comma-separated) named by /.well-known/apple-app-site-association for passkeys
    // (webcredentials) and links (applinks). ANDROID_APPS (<package>@<SHA-256 cert fingerprint>, comma-separated)
    // fills /.well-known/assetlinks.json the same way. Unset = that file is a 404. packages/server/src/well-known.ts.
    "APPLE_APP_IDS": "NBDP5VK335.sh.segv.desktop",
  },
  // Workers Logs: keep only our own console.error lines (they never contain addresses, ids or bodies).
  // Invocation logs would retain every request's URL (handles, credential / blob ids) and request
  // metadata for days, which the design promises not to keep.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "routes": [{ "pattern": "segv.sh", "custom_domain": true }],
  // https://canary.segv.sh (docs/DEPLOYMENT.md, "Canary"): another deployment, which every push to main deploys before
  // a release tag deploys segv.sh. It is the Worker segv-sh-canary with its own storage, secrets and accounts: its
  // passkeys (RP ID canary.segv.sh) and its data never reach segv.sh. segv.sh Canary, the Canary desktop app, calls it.
  // Use it with `--env canary`. Wrangler does not inherit bindings or variables into an environment, so each one is
  // repeated here; the rest (main, assets, compatibility, Durable Object migrations, logs) is the deployment's above.
  "env": {
    "canary": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "segv-canary",
          "database_id": "f4e5945a-1acc-4c90-bfda-790e16a861b1",
          "migrations_dir": "../../packages/server/migrations",
        },
        {
          "binding": "DIRLOG",
          "database_name": "segv-canary",
          "database_id": "f4e5945a-1acc-4c90-bfda-790e16a861b1",
          "migrations_dir": "../../packages/server/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "segv-blobs-canary" }],
      "kv_namespaces": [{ "binding": "PUSH_KV", "id": "c2c4e7524e394831b1b4caef058180b5" }],
      "queues": {
        "producers": [{ "binding": "PUSH_QUEUE", "queue": "segv-push-canary" }],
        "consumers": [
          {
            "queue": "segv-push-canary",
            "max_batch_size": 100,
            "max_batch_timeout": 1,
            "max_retries": 3,
          },
        ],
      },
      "triggers": { "crons": ["17 3 * * *"] },
      "durable_objects": {
        "bindings": [
          { "name": "SHARD", "class_name": "ShardDO" },
          { "name": "BLOBREG", "class_name": "BlobRegDO" },
          { "name": "DIRSEQ", "class_name": "DirSeqDO" },
          { "name": "KEYS", "class_name": "KeyDO" },
          { "name": "INBOX", "class_name": "InboxDO" },
          { "name": "CONN", "class_name": "ConnDO" },
          { "name": "FEED", "class_name": "FeedDO" },
          { "name": "CKPT", "class_name": "CheckpointDO" },
          { "name": "QUIET", "class_name": "QuietDO" },
        ],
      },
      // Ids that no other Worker of the account uses.
      "ratelimits": [
        { "name": "RL_WRITE", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_BLOB", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_READ", "namespace_id": "2003", "simple": { "limit": 600, "period": 60 } },
        { "name": "RL_INBOX", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_RING", "namespace_id": "2005", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_SEEN", "namespace_id": "2006", "simple": { "limit": 60, "period": 60 } },
      ],
      "vars": {
        "POW_REGISTER": "20",
        "POW_WRAP": "18",
        "POW_PUT": "16",
        "POW_INBOX": "18",
        "POW_BLOB": "18",
        "DELTA_S": "10",
        "SKEW_S": "2",
        "INBOX_SLOT_S": "10",
        "E_FIRST": "42",
        "RT_CONNS": "4",
        "RT_FEEDS": "4",
        "BLOBREG_SHARDS": "64",
        "PUSH_SHARDS": "4",
        "APP_HOSTS": "canary.segv.sh",
        // The desktop apps' pages (segv.sh Canary on macOS); the mobile apps are segv.sh's only.
        "APP_ORIGINS": "tauri://localhost,https://tauri.localhost",
        "APPLE_APP_IDS": "NBDP5VK335.sh.segv.desktop.canary",
      },
      "routes": [{ "pattern": "canary.segv.sh", "custom_domain": true }],
    },
  },
}
