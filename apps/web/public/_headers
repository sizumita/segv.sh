# https://developers.cloudflare.com/workers/static-assets/headers/
# Applies to static files served by the assets binding. HTML rendered by the Worker gets its
# CSP + security headers from src/routes/plugin@csp.ts instead.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Resource-Policy: same-origin

/*service-worker.js
  Cache-Control: no-store
  Content-Type: application/javascript

# The push Service Worker (docs/PROTOCOL.md §11.13), built from packages/engine/src/sw-main.ts: never cached; it loads
# nothing and reads rows from this origin's API only (the `message` preview).
/sw.js
  Cache-Control: no-store
  Content-Type: application/javascript
  Content-Security-Policy: default-src 'none'; connect-src 'self'

/build/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable
