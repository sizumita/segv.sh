{
  "name": "segv-sh",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @segv/web run dev",
    "build": "pnpm --filter @segv/web run build",
    "preview": "pnpm --filter @segv/web run preview",
    "deploy": "pnpm --filter @segv/web run deploy",
    "db:migrate:local": "pnpm --filter @segv/web run db:migrate:local",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check:workspace": "node scripts/check-workspace.mjs && pnpm dedupe --check && pnpm peers check -r",
    "typecheck": "tsc --noEmit -p . && pnpm --recursive run typecheck",
    "test": "vp test run",
    "test:e2e": "pnpm --filter @segv/web run test:e2e"
  },
  "devDependencies": {
    "eslint-plugin-qwik": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
