{
  "name": "segv-sh",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --mode ssr",
    "build": "qwik build",
    "build.client": "vp build",
    "build.server": "qwik check-client src dist && vp build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "lint": "vp lint src",
    "fmt": "vp fmt",
    "preview": "qwik build && wrangler dev",
    "deploy": "qwik build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "qwik": "qwik",
    "test": "vp test run",
    "check": "vp check",
    "test:e2e": "node test/e2e/run.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/vitest-plugin": "1.4.9",
    "@qwik.dev/core": "2.0.0-rc.4",
    "@qwik.dev/router": "2.0.0-rc.4",
    "@types/node": "25.6.0",
    "eslint-plugin-qwik": "2.0.0-rc.4",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
